pkgbase=linux-t2
pkgver=7.2.8.arch1
pkgrel=1
pkgdesc='Linux for T2 Macs'
url='https://github.com/archlinux/linux'
arch=(
  x86_64
)
license=(GPL-2.0-only)
makedepends=(
  bc
  binutils
  cpio
  gettext
  git
  glibc
  libelf
  libgcc
  openssl
  pahole
  perl
  python
  rust
  rust-bindgen
